{
  "compilerOptions": {
    "target": "ES2018",
    "strictNullChecks": true,
    "declaration": true,
    "module": "commonJS",
    "outDir": "build",
    "moduleResolution": "Node",
    "noImplicitAny": true,
    "sourceMap": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2018", "DOM"],
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,
    "types": ["node"]
  },
  "include": ["ts/**/*"],
  "exclude": ["build"],
  "compileOnSave": true
}
