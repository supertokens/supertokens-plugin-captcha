{
  "name": "supertokens-plugin-captcha",
  "version": "0.0.1",
  "description": "SuperTokens plugin for adding CAPTCHA support.",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test-exports": "./test/testExports.sh",
    "build-check": "cd lib && npx tsc -p tsconfig.json --noEmit && cd ../test/with-typescript && npm run build",
    "build:frontend": "tsc -p frontend/tsconfig.json",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run build:frontend && npm run build:backend",
    "pretty": "npx pretty-quick .",
    "build-pretty": "npm run build && npm run pretty",
    "pretty-check": "npx pretty-quick --check ."
  },
  "keywords": [],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./backend": {
      "types": "./backend/index.d.ts",
      "default": "./backend/index.js"
    },
    "./backend/index": {
      "types": "./backend/index.d.ts",
      "default": "./backend/index.js"
    },
    "./backend/index.js": {
      "types": "./backend/index.d.ts",
      "default": "./backend/index.js"
    },
    "./frontend": {
      "types": "./frontend/index.d.ts",
      "default": "./frontend/index.js"
    },
    "./frontend/index": {
      "types": "./frontend/index.d.ts",
      "default": "./frontend/index.js"
    },
    "./frontend/index.js": {
      "types": "./frontend/index.d.ts",
      "default": "./frontend/index.js"
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "supertokens-auth-react": "github:supertokens/supertokens-auth-react#improv/extend-components",
    "supertokens-node": "github:supertokens/supertokens-node#feat/plugin/recursive-dependencies"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^23.0.3",
    "@rollup/plugin-json": "^5.0.0",
    "@rollup/plugin-multi-entry": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/pluginutils": "^5.0.2",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/grecaptcha": "^3.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "mocha": "^10.2.0",
    "postcss": "^8.4.19",
    "postcss-import": "^15.0.0",
    "postcss-preset-env": "^7.8.3",
    "prettier": "2.0.5",
    "pretty-quick": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^14.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  },
  "browser": {
    "fs": false
  }
}
